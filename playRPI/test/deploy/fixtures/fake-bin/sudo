#!/bin/sh
# Заглушка sudo: записывает вызов в $FAKE_SUDO_LOG и выполняет команду дальше.
#
# ВАЖНО: update.mjs зовёт `sudo /bin/systemctl ...` с АБСОЛЮТНЫМ путём.
# Если запустить его как есть, мы попадём в настоящий systemctl (в тестовом
# контейнере он существует!) вместо заглушки. Поэтому от первого аргумента
# берём только имя файла — тогда сработает подстановка через PATH, где
# fixtures/fake-bin стоит первым.

[ -n "$FAKE_SUDO_LOG" ] && echo "$*" >> "$FAKE_SUDO_LOG"

cmd=$(basename "$1")
shift
exec "$cmd" "$@"
