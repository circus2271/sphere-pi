# Контекст сборки — корень репозитория, а там много лишнего.
# BuildKit подхватывает <Dockerfile>.dockerignore рядом с самим Dockerfile,
# поэтому корневой .dockerignore трогать не пришлось.

# node_modules собран под Windows — в контейнере ставим свой через npm ci
**/node_modules
.git

