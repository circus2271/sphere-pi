# ─────────────────────────────────────────────────────────────
#  systemd-сервис плеера (режим 24/7)
#
#  Установка:
#    sudo cp deploy/sphere-player.service /etc/systemd/system/
#    sudo systemctl daemon-reload
#    sudo systemctl enable --now sphere-player
#
#  Полезное:
#    systemctl status sphere-player      — состояние
#    journalctl -u sphere-player -f      — живые логи
#    sudo systemctl restart sphere-player — ручной перезапуск
#
#  ВАЖНО: Restart=always уместен только для mode24h: true.
#  В режиме daySchedule плеер сам выходит на ночь (exit 0) —
#  для него поменяй на Restart=on-failure и оставь утренний
#  запуск за crontab/systemd-таймером.
# ─────────────────────────────────────────────────────────────
[Unit]
Description=Sphere Pi audio player (24/7)
After=network.target sound.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/sphere-pi/playRPI
ExecStart=/usr/bin/node node-sound-player-production.js
Restart=always
RestartSec=5

# Мягкая остановка: SIGTERM у node завершает процесс сразу —
# для ручного systemctl stop/restart этого достаточно.
# Мягкое обновление делает deploy/update.sh через SIGUSR2.

[Install]
WantedBy=multi-user.target
